{
  "name": "@buzzr/dfs-react",
  "version": "5.0.0",
  "description": "Framework-agnostic display helpers for rendering @buzzr/dfs-engine settlements — turns DfsSettlementResult into a clean view-model for React, Vue, Svelte, or plain HTML.",
  "license": "MIT",
  "author": "Sarvesh Chidambaram",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Buzzr-app/dfs-engine.git",
    "directory": "packages/dfs-react"
  },
  "homepage": "https://github.com/Buzzr-app/dfs-engine/tree/main/packages/dfs-react#readme",
  "bugs": {
    "url": "https://github.com/Buzzr-app/dfs-engine/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --treeshake --target es2022",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "keywords": [
    "dfs",
    "daily-fantasy-sports",
    "react",
    "vue",
    "svelte",
    "view-model",
    "headless-ui",
    "settlement",
    "betslip",
    "player-props",
    "prizepicks",
    "underdog",
    "typescript",
    "buzzr"
  ],
  "dependencies": {
    "@buzzr/dfs-engine": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
